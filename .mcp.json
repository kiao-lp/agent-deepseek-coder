{
  "mcpServers": {
    "kiao-hybridflow": {
      "type": "stdio",
      "command": "kiao-mcp-hybridflow",
      "args": []
    },
    "fetch": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "--with",
        "mcp<2",
        "--from",
        "mcp-server-fetch==2026.8.18",
        "mcp-server-fetch"
      ]
    },
    "markitdown": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "--from",
        "markitdown-mcp==0.0.1a4",
        "markitdown-mcp"
      ]
    },
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "--yes",
        "@playwright/mcp@0.0.79",
        "--headless",
        "--isolated",
        "--browser",
        "chromium"
      ]
    }
  }
}
